+//! Craft snapshot v2: restore validated glyph registrations without replaying
+//! terminal output, moving the cursor, or generating protocol responses.
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+const Glyph = @import("../apc/glyph.zig");
+const record = @import("record.zig");
+const io = @import("io.zig");
+
+const max_registration_bytes = 1024 * 1024;
+const max_payload_bytes = 16 * 1024 * 1024;
+pub const EncodeError = std.Io.Writer.Error || record.Writer.FinishError || error{InvalidGlyphRecord};
+pub const DecodeError = std.Io.Reader.Error || Allocator.Error || record.Reader.InitError ||
+    record.Reader.FinishError || error{InvalidGlyphRecord};
+
+pub fn encode(glossary: *const Glyph.Glossary, stream: *record.Writer) EncodeError!void {
+    const count = glossary.entries.count();
+    if (count > Glyph.Glossary.max_entries) return error.InvalidGlyphRecord;
+    var size: usize = 2;
+    for (glossary.entries.keys(), glossary.entries.values()) |cp, entry| {
+        const raw = entry.registration;
+        if (raw.len == 0 or raw.len > max_registration_bytes) return error.InvalidGlyphRecord;
+        const request = Glyph.Request.Register.init(raw) orelse return error.InvalidGlyphRecord;
+        if (request.get(.cp) != cp) return error.InvalidGlyphRecord;
+        size += 8 + raw.len;
+        if (size > max_payload_bytes) return error.InvalidGlyphRecord;
+    }
+    const writer = stream.begin(.glyphs);
+    errdefer stream.cancel();
+    try io.writeInt(writer, u16, @intCast(count));
+    for (glossary.entries.keys(), glossary.entries.values()) |cp, entry| {
+        try io.writeInt(writer, u32, @intCast(cp));
+        try io.writeInt(writer, u32, @intCast(entry.registration.len));
+        try writer.writeAll(entry.registration);
+    }
+    try stream.finish();
+}
+
+pub fn decode(source: *std.Io.Reader, alloc: Allocator, glossary: *Glyph.Glossary) DecodeError!void {
+    var framed: record.Reader = undefined;
+    try framed.init(source);
+    if (framed.header.tag != .glyphs or framed.header.payload_len > max_payload_bytes)
+        return error.InvalidGlyphRecord;
+    const reader = framed.payloadReader();
+    const count = try io.readInt(reader, u16);
+    if (count > Glyph.Glossary.max_entries) return error.InvalidGlyphRecord;
+    var decoded: Glyph.Glossary = .empty;
+    errdefer decoded.deinit(alloc);
+    var consumed: usize = 2;
+    for (0..count) |_| {
+        const cp = std.math.cast(u21, try io.readInt(reader, u32)) orelse return error.InvalidGlyphRecord;
+        const length = try io.readInt(reader, u32);
+        consumed += 8;
+        if (length == 0 or length > max_registration_bytes or consumed + length > framed.header.payload_len)
+            return error.InvalidGlyphRecord;
+        const raw = try alloc.alloc(u8, length);
+        defer alloc.free(raw);
+        try reader.readSliceAll(raw);
+        consumed += length;
+        const request = Glyph.Request.Register.init(raw) orelse return error.InvalidGlyphRecord;
+        if (request.get(.cp) != cp or decoded.contains(cp)) return error.InvalidGlyphRecord;
+        var entry = Glyph.Glossary.Entry.init(alloc, request) catch |err| switch (err) {
+            error.OutOfMemory => return error.OutOfMemory,
+            else => return error.InvalidGlyphRecord,
+        };
+        decoded.register(alloc, cp, entry) catch |err| {
+            entry.deinit(alloc);
+            return switch (err) {
+                error.OutOfMemory => error.OutOfMemory,
+                else => error.InvalidGlyphRecord,
+            };
+        };
+    }
+    try framed.finish();
+    glossary.deinit(alloc);
+    glossary.* = decoded;
+}
