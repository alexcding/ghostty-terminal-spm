+/// Select daemon-state-v1 only after importing a fresh host-owned snapshot.
+/// Ownership cannot change after live output, eliminating attach/detach races.
+pub fn enableHostStateResponses(self: *Termio, identity: bool, geometry: bool) !void {
+    self.renderer_state.mutex.lockUncancelable(global.io());
+    defer self.renderer_state.mutex.unlock(global.io());
+    if (!self.host_ordered_grid or !self.snapshot_metadata_pending or
+        self.backend != .host_managed) return error.NoFreshImportedState;
+    // The identity profile advertises clipboard access using the native
+    // default policy. Reject a mismatched surface instead of lying to programs.
+    if (identity and self.terminal_stream.handler.clipboard_write != .allow)
+        return error.IncompatibleClipboardPolicy;
+    if (geometry) {
+        const t = &self.terminal;
+        if (!identity or !self.host_snapshot_geometry or t.width_px == 0 or t.height_px == 0 or
+            t.width_px > 65535 or t.height_px > 65535 or
+            t.width_px % t.cols != 0 or t.height_px % t.rows != 0)
+            return error.InvalidHostGeometry;
+    }
+    if (self.terminal_stream.handler.host_geometry_responses and !geometry)
+        return error.CannotChangeGeometryOwner;
+    self.terminal_stream.handler.host_state_responses = true;
+    self.terminal_stream.handler.host_identity_responses = identity;
+    self.terminal_stream.handler.host_geometry_responses = geometry;
+}
+
+/// Run off the UI thread before live output. A full app mailbox can block
+/// until the UI ticks; callers must not hold up that event loop.
+pub fn publishSnapshotMetadata(self: *Termio) !void {
+    self.renderer_state.mutex.lockUncancelable(global.io());
+    defer self.renderer_state.mutex.unlock(global.io());
+    if (!self.snapshot_metadata_pending) return error.NoPendingSnapshotMetadata;
+    self.snapshot_metadata_pending = false;
+    try self.terminal_stream.handler.publishSnapshotMetadata();
+}
