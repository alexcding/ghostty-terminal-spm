+/// Apply a daemon resize at its position in the output sequence. The host
+/// serializes this with its writes, while view/pixel resizes only request a new
+/// daemon size. This avoids reflowing output that predates the resize event.
+pub fn applyHostGridSize(self: *Termio, cols: u16, rows: u16, cell_width: ?u32, cell_height: ?u32) !void {
+    if (cols == 0 or rows == 0 or cols > 4096 or rows > 4096 or
+        @as(u32, cols) * @as(u32, rows) > 1024 * 1024) return error.InvalidGrid;
+    self.renderer_state.mutex.lockUncancelable(global.io());
+    defer self.renderer_state.mutex.unlock(global.io());
+    if (!self.host_ordered_grid or self.backend != .host_managed) return error.NoImportedState;
+    const geometry_owned = self.terminal_stream.handler.host_geometry_responses;
+    if (geometry_owned != (cell_width != null) or geometry_owned != (cell_height != null))
+        return error.IncompatibleGeometryOwner;
+    const width = cell_width orelse self.size.cell.width;
+    const height = cell_height orelse self.size.cell.height;
+    if (geometry_owned and (width == 0 or height == 0 or
+        @as(u64, width) * cols > 65535 or @as(u64, height) * rows > 65535))
+        return error.InvalidHostGeometry;
+    try self.terminal.resize(self.alloc, .{
+        .cols = cols,
+        .rows = rows,
+        .cell_size_px = .{ .width = width, .height = height },
+    });
+    if (!geometry_owned and self.terminal.modes.get(.in_band_size_reports)) {
+        var buf: [1024]u8 = undefined;
+        var writer: std.Io.Writer = .fixed(&buf);
+        try terminalpkg.size_report.encode(&writer, .mode_2048, .{
+            .rows = rows,
+            .columns = cols,
+            .cell_width = self.size.cell.width,
+            .cell_height = self.size.cell.height,
+        });
+        self.mailbox.send(try termio.Message.writeReq(self.alloc, writer.buffered()), self.renderer_state.mutex);
+        self.mailbox.notify();
+    }
+    self.renderer_wakeup.notify() catch {};
+}
