+pub const HostAppearanceCallback = *const fn (?*anyopaque, [*]const u32, usize) callconv(.c) void;
+
+pub fn setHostAppearanceCallback(self: *Termio, callback: HostAppearanceCallback) !void {
+    self.renderer_state.mutex.lockUncancelable(global.io());
+    defer self.renderer_state.mutex.unlock(global.io());
+    if (self.backend != .host_managed or self.config.osc_color_report_format != .@"16-bit")
+        return error.IncompatibleAppearancePolicy;
+    self.host_appearance_callback = callback;
+    self.notifyHostAppearance();
+}
+
+fn encodeHostRGB(value: ?terminalpkg.color.RGB) u32 {
+    const c = value orelse return std.math.maxInt(u32);
+    return (@as(u32, c.r) << 16) | (@as(u32, c.g) << 8) | c.b;
+}
+fn decodeHostRGB(value: u32) ?terminalpkg.color.RGB {
+    if (value == std.math.maxInt(u32)) return null;
+    return .{ .r = @truncate(value >> 16), .g = @truncate(value >> 8), .b = @truncate(value) };
+}
+fn notifyHostAppearance(self: *Termio) void {
+    const callback = self.host_appearance_callback orelse return;
+    if (self.backend != .host_managed) return;
+    var values: [260]u32 = undefined;
+    for (self.config.palette, 0..) |c, i| values[i] = encodeHostRGB(c);
+    values[256] = encodeHostRGB(self.config.foreground.toTerminalRGB());
+    values[257] = encodeHostRGB(self.config.background.toTerminalRGB());
+    values[258] = encodeHostRGB(if (self.config.cursor_color) |c| c.toTerminalRGB() else null);
+    values[259] = switch (self.config.conditional_state.theme) { .light => 0, .dark => 1 };
+    // Borrowed stack bytes: the host copies/enqueues them without re-entering us.
+    callback(self.backend.host_managed.userdata, &values, values.len);
+}
